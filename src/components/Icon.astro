---
/**
 * The site's icon set — one small line drawing per idea, all on the same
 * 24×24 grid with the same stroke weight so they read as a family.
 */
export type IconName =
  | 'nutrition'
  | 'habits'
  | 'lifestyle'
  | 'feelings'
  | 'family'
  | 'skills'
  | 'plate'
  | 'menu'
  | 'palate'
  | 'mealtime'
  | 'energy'
  | 'empower'
  | 'sprout';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* Nutrition — a bowl of food */}
  {
    name === 'nutrition' && (
      <>
        <path d="M3.2 11h17.6a8.8 8.8 0 0 1-8.8 8.8A8.8 8.8 0 0 1 3.2 11Z" />
        <path d="M8.6 8.2c-.9-1.4-.5-3 .9-3.9" />
        <path d="M12.4 7.9c-.6-1.6.1-3.1 1.7-3.7" />
        <path d="M16 8.4c-.3-1.2.3-2.2 1.4-2.7" />
      </>
    )
  }

  {/* Eating habits — a clock */}
  {
    name === 'habits' && (
      <>
        <circle cx="12" cy="12" r="8.4" />
        <path d="M12 7.6V12l3.2 1.9" />
      </>
    )
  }

  {/* Lifestyle — sun and movement */}
  {
    name === 'lifestyle' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3.4v2.1M12 18.5v2.1M3.4 12h2.1M18.5 12h2.1M6 6l1.5 1.5M16.5 16.5 18 18M18 6l-1.5 1.5M7.5 16.5 6 18" />
      </>
    )
  }

  {/* Emotional well-being — a heart */}
  {
    name === 'feelings' && (
      <path d="M12 19.5S4.4 15.3 4.4 9.9A3.9 3.9 0 0 1 12 8.3a3.9 3.9 0 0 1 7.6 1.6c0 5.4-7.6 9.6-7.6 9.6Z" />
    )
  }

  {/* Family environment — a home */}
  {
    name === 'family' && (
      <>
        <path d="M4 10.4 12 4l8 6.4v8.2a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 18.6Z" />
        <path d="M9.6 20v-4.8a2.4 2.4 0 0 1 4.8 0V20" />
      </>
    )
  }

  {/* Life skills — a growing sprout */}
  {
    (name === 'skills' || name === 'sprout') && (
      <>
        <path d="M12 20v-7.6" />
        <path d="M12 12.4C12 9.3 9.7 6.9 6.6 6.6c-.3 3.1 2 5.5 5.4 5.8Z" />
        <path d="M12 12.4c0-3.1 2.3-5.5 5.4-5.8.3 3.1-2 5.5-5.4 5.8Z" />
      </>
    )
  }

  {/* Plan the plate — a plate divided */}
  {
    name === 'plate' && (
      <>
        <circle cx="12" cy="12" r="8.4" />
        <circle cx="12" cy="12" r="4.6" />
        <path d="M12 3.6v3.8M20.4 12h-3.8" />
      </>
    )
  }

  {/* Build the menu — a list */}
  {
    name === 'menu' && (
      <>
        <path d="M9 6.6h11M9 12h11M9 17.4h11" />
        <path d="M4.4 6.6h.6M4.4 12h.6M4.4 17.4h.6" />
      </>
    )
  }

  {/* Expand their palate — a leaf opening out */}
  {
    name === 'palate' && (
      <>
        <path d="M19.6 4.4C11 4.4 6.2 8 6.2 13.4a6.2 6.2 0 0 0 1.5 4.2C13.9 17.4 19.6 13 19.6 4.4Z" />
        <path d="M5 20c1.5-3.4 4-6.2 7.2-8" />
      </>
    )
  }

  {/* Make mealtimes easier — a calm face */}
  {
    name === 'mealtime' && (
      <>
        <circle cx="12" cy="12" r="8.4" />
        <path d="M8.6 14.2a4.2 4.2 0 0 0 6.8 0" />
        <path d="M9.2 9.6h.02M14.8 9.6h.02" />
      </>
    )
  }

  {/* Energy & vitality — a spark */}
  {
    name === 'energy' && (
      <>
        <path d="M12 3.2 13.9 9l6 .3-4.7 3.7 1.6 5.8-4.8-3.4-4.8 3.4 1.6-5.8L4.1 9.3l6-.3Z" />
      </>
    )
  }

  {/* Empower the family — cupped hands */}
  {
    name === 'empower' && (
      <>
        <path d="M4 11.4v2.2a6.6 6.6 0 0 0 6.6 6.6h2.8a6.6 6.6 0 0 0 6.6-6.6v-2.2" />
        <path d="M8.4 11.4V8a1.6 1.6 0 0 1 3.2 0v3.4M11.6 11.4V6.6a1.6 1.6 0 0 1 3.2 0v4.8" />
      </>
    )
  }
</svg>

---
import { credentials } from '../data/site';

interface Props {
  tone?: 'cream' | 'forest';
}
const { tone = 'cream' } = Astro.props;
const invert = tone === 'forest';
---

<div
  class:list={[
    'grid gap-px overflow-hidden rounded-3xl sm:grid-cols-2 lg:grid-cols-4',
    invert ? 'bg-white/10' : 'bg-forest-900/10',
  ]}
>
  {
    credentials.map((item) => (
      <div
        class:list={['reveal flex flex-col justify-between gap-4 p-7 sm:p-8', invert ? 'bg-forest-950' : 'bg-cream']}
      >
        <p
          class:list={[
            'font-display text-[1.75rem] leading-none font-semibold sm:text-[2rem]',
            invert ? 'text-white' : 'text-forest-900',
          ]}
        >
          {item.value}
        </p>
        <div>
          <p class:list={['text-[0.95rem] font-bold', invert ? 'text-apricot-300' : 'text-apricot-700']}>
            {item.label}
          </p>
          <p class:list={['mt-1.5 text-[0.85rem] leading-relaxed', invert ? 'text-forest-200/70' : 'text-forest-600']}>
            {item.note}
          </p>
        </div>
      </div>
    ))
  }
</div>

---
import Button from './Button.astro';
import Sprig from './Sprig.astro';
import { bookingHref, bookingIsExternal, booking } from '../data/site';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  primary?: { href: string; label: string; external?: boolean };
  secondary?: { href: string; label: string; external?: boolean };
  /** The three promises, shown between the text and the buttons. */
  promises?: readonly string[];
}

const {
  eyebrow = 'Ready to begin?',
  title,
  text,
  primary = { href: bookingHref, label: booking.label, external: bookingIsExternal },
  secondary,
  promises,
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-forest-950">
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[28rem] w-[42rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(212,122,43,0.22),transparent_68%)]"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-5 py-20 text-center sm:px-8 sm:py-24 lg:py-28">
    <Sprig class="mx-auto h-6 w-auto text-apricot-400/70" />
    <p class="eyebrow mt-8 !text-apricot-300">{eyebrow}</p>
    <h2 class="mt-4 text-[2rem] leading-[1.14] font-semibold !text-white sm:text-[2.6rem]">{title}</h2>
    <p class="mx-auto mt-6 max-w-xl text-[1.02rem] leading-relaxed text-forest-100/75">{text}</p>

    {
      promises && (
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {promises.map((promise) => (
            <li class="text-[0.92rem] font-semibold text-apricot-200">{promise}</li>
          ))}
        </ul>
      )
    }

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <Button href={primary.href} variant="primary" external={primary.external}>{primary.label}</Button>
      {secondary && (
        <Button href={secondary.href} variant="ghost" external={secondary.external}>{secondary.label}</Button>
      )}
    </div>
  </div>
</section>

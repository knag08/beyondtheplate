---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  number: string;
  icon: IconName;
  title: string;
  question: string;
  text: string;
}

const { number, icon, title, question, text } = Astro.props;
---

<article
  class="reveal group relative flex h-full flex-col rounded-3xl border border-forest-900/10 bg-white/70 p-7 transition duration-500 hover:border-apricot-300 hover:bg-white sm:p-8"
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-sage-mist text-forest-600 transition duration-500 group-hover:bg-apricot-50 group-hover:text-apricot-700"
    >
      <Icon name={icon} class="h-6 w-6" />
    </span>
    <span class="font-display text-[1.6rem] leading-none font-semibold text-forest-900/15 tabular-nums">{number}</span>
  </div>

  <h3 class="mt-6 text-[1.3rem] leading-snug font-semibold">{title}</h3>
  <p class="mt-2 text-[0.95rem] font-semibold text-apricot-700">{question}</p>
  <p class="mt-4 text-[0.98rem] leading-relaxed text-forest-600">{text}</p>
</article>
